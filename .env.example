# Postgres connection string. A free Neon (https://neon.tech) database works well
# for both local development and Vercel deployment.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"

# Local dev: http://localhost:3000  |  Prod: your deployed URL
NEXTAUTH_URL="http://localhost:3000"

# SMTP for outgoing email (share invites/notifications). Optional — if these are
# unset the app skips sending and just logs a warning.
# Free provider: Brevo (https://www.brevo.com) gives 300 emails/day with no card;
# create an SMTP key under "SMTP & API". Mailtrap works for dev-only testing.
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-login"
SMTP_PASS="your-smtp-key"
EMAIL_FROM="Ajaia Docs <no-reply@yourdomain.com>"
