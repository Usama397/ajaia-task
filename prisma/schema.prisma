generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String            @id @default(cuid())
  name         String?
  email        String            @unique
  passwordHash String
  createdAt    DateTime          @default(now())
  documents    Document[]        @relation("OwnedDocuments")
  sharedWithMe DocumentShare[]
  sentInvites  DocumentInvite[]  @relation("SentInvites")
  versions     DocumentVersion[]
  comments     Comment[]
  presence     Presence[]
  notifications Notification[]
}

model Document {
  id          String            @id @default(cuid())
  title       String
  contentJson Json
  ownerId     String
  owner       User              @relation("OwnedDocuments", fields: [ownerId], references: [id], onDelete: Cascade)
  shares      DocumentShare[]
  invites     DocumentInvite[]
  versions    DocumentVersion[]
  comments    Comment[]
  presence    Presence[]
  notifications Notification[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([ownerId])
}

enum SharePermission {
  VIEW
  COMMENT
  EDIT
}

model DocumentShare {
  id         String          @id @default(cuid())
  documentId String
  document   Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission SharePermission @default(EDIT)
  createdAt  DateTime        @default(now())

  @@unique([documentId, userId])
  @@index([userId])
}

model DocumentInvite {
  id          String          @id @default(cuid())
  documentId  String
  document    Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  email       String
  permission  SharePermission @default(EDIT)
  invitedById String
  invitedBy   User            @relation("SentInvites", fields: [invitedById], references: [id], onDelete: Cascade)
  token       String          @unique @default(cuid())
  createdAt   DateTime        @default(now())

  @@unique([documentId, email])
  @@index([email])
}

model DocumentVersion {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  title       String
  contentJson Json
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([documentId])
}

model Comment {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body       String
  quote      String?
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([documentId])
}

model Presence {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSeenAt DateTime @default(now())

  @@unique([documentId, userId])
  @@index([documentId])
}

enum NotificationType {
  SHARE
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType @default(SHARE)
  actorName  String
  message    String
  documentId String?
  document   Document?        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}
